{
  "name": "rummikub-scores",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build && concurrently -n vite,wrangler -c blue,green \"vite build --watch\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.unit.json --noEmit && tsc -p tsconfig.test.integration.json --noEmit && tsc -p tsconfig.test.component.json --noEmit && tsc -p tsconfig.test.e2e.json --noEmit && tsc -p tsconfig.test.cucumber.json --noEmit",
    "lint": "oxlint .",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:cucumber:component": "cucumber-js -p component",
    "test:cucumber:integration": "cucumber-js -p integration",
    "test:cucumber:e2e": "cucumber-js -p e2e",
    "test:cucumber": "npm run test:cucumber:component && npm run test:cucumber:integration && npm run test:cucumber:e2e",
    "seed": "tsx scripts/seed.ts",
    "build:standalone": "esbuild src/standalone/server.ts --bundle --platform=node --format=esm --outfile=dist/standalone/server.mjs --external:node:sqlite",
    "start:standalone": "node dist/standalone/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "workerd@1.20260815.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
